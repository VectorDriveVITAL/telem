# Copy this to .env and adjust if you're not using the bundled docker-compose
# setup (e.g. pointing at InfluxDB Cloud or a token you generated yourself).
# All of these match docker-compose.yml's defaults out of the box.

INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=dev-super-secret-token
INFLUX_ORG=telem
INFLUX_BUCKET=telemetry

# How often the simulator writes a new live point per series
TICK_SECONDS=3

# How much synthetic history to backfill on first startup or upgrade (minutes)
HISTORY_MINUTES=1440

# Comma-separated list, or * for local dev
CORS_ORIGINS=*

# Durable operational state. Use one Uvicorn worker.
STATE_DB=.telem/state.sqlite3
# Set false for an empty fleet on the first run.
SEED_DEMO=true

# Forward all buoy readings (real and simulated) to the VITAL sensor API.
# Off unless username, password and campaign id are all set.
# VITAL_API_URL=https://vitalapi.pods.portals.tapis.io/api/v1
VITAL_USERNAME=
VITAL_PASSWORD=
VITAL_CAMPAIGN_ID=
