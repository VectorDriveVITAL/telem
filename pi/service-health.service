# /etc/systemd/system/service-health.service  (adjust the paths to where telem is installed)
[Unit]
Description=Report the Pi's services to telem
After=network-online.target telem.service

[Service]
EnvironmentFile=-/etc/default/service-health
ExecStart=/opt/telem/.venv/bin/python /opt/telem/pi/service_health.py
Restart=always
RestartSec=5
User=vitalpi

[Install]
WantedBy=multi-user.target
